<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your msg</title>
</head>
<body>
    <h3>Edit the chat : <%= chat._id %> </h3>
    <p>This chat is sent from <b><%= chat.from %></b> to <b><%= chat.to %></b> </p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea name="msg" rows="6" cols="20"><%= chat.msg %> </textarea>
        <br>
        <button>Edit</button>
    </form>
</body>
</html>